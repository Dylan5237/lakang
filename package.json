{
  "name": "lakang-cards",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "拉康随身读：拉康派临床演示记录（私人，服务器端密码保护）",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/make-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "clinical": "python scripts/build_clinical.py",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  }
}
